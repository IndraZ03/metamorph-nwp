        bindModalClose(this.el.root, () => this.close());
    }

    open(layer) {
        this.layer = layer;
        this.el.title.textContent = `Pengaturan \u00b7 ${layer.title}`;

        this.renderDisplay();
        this.renderLineColor();
        this.renderDensity();
        this.renderColorbars();
        this.renderThreshold();

        this.el.root.hidden = false;
    }

    close() {
        this.el.root.hidden = true;
        this.layer = null;
    }

    /* ---- tampilan: kontur terisi atau garis ---- */

    renderDisplay() {
        const wrap  = this.el.display;
        const layer = this.layer;
        wrap.innerHTML = "";

        if (!layer.canSwitchDisplay) {
            wrap.innerHTML = '<p class="pick-hint">Tidak tersedia untuk layer ini.</p>';
            return;
        }

        [["fill", "Kontur (isi)"], ["line", "Garis"]].forEach(([mode, label]) => {
            const b = document.createElement("button");
            b.type        = "button";
            b.className   = "chip" + (layer.displayMode === mode ? " is-active" : "");
            b.textContent = label;
            b.addEventListener("click", () => {
                layer.setDisplayMode(mode);
                [...wrap.children].forEach(c => c.classList.remove("is-active"));
                b.classList.add("is-active");
                // Warna solid cuma relevan di mode garis, jadi bagian
                // ini perlu digambar ulang tiap mode berganti.
                this.renderLineColor();
                this.onChange?.();
            });
            wrap.appendChild(b);
        });

        // Haluskan garis — lewat kurva B-spline (curveBasis), bukan
        // smoothing bawaan d3-contour yang cuma soal akurasi titik
        // potong grid. Berlaku untuk kedua mode (fill maupun line),
        // jadi ditaruh di sini, bukan di dalam salah satu chip mode.
        const smoothRow = document.createElement("label");
        smoothRow.className = "fill-check smooth-line";
        smoothRow.style.flexBasis = "100%";
        smoothRow.style.marginTop = "4px";

        const cb = document.createElement("input");
        cb.type    = "checkbox";
        cb.checked = !!layer.instance?.smooth;
        cb.addEventListener("change", () => {
            layer.setSmooth(cb.checked);
            this.onChange?.();
        });

        smoothRow.append(cb, document.createTextNode("Haluskan garis"));
        wrap.appendChild(smoothRow);
    }

    /* ---- warna garis: override solid, hanya untuk mode garis ---- */

    /**
     * Warna solid. Berlaku untuk dua kasus yang beda konsep tapi sama
     * mekanismenya (keduanya lewat layer.setColor()):
     *   - windbarb  : selalu ada, tidak ada "otomatis" karena barb tidak
     *                 punya skala warna per-band untuk kembali ke situ.
     *   - line (NWP): cuma relevan saat mode Garis aktif; di mode Kontur
     *                 warna per band dari skala warna yang dipakai, jadi
     *                 bagian ini disembunyikan dengan keterangan kenapa.
     */
    renderLineColor() {
        const wrap  = this.el.lineColor;
        const layer = this.layer;
        wrap.innerHTML = "";

        if (!layer.colorable) {
            this.el.lineSection.hidden = true;
            return;
        }

        if (layer.canSwitchDisplay && layer.displayMode !== "line") {
            this.el.lineSection.hidden = false;
            wrap.innerHTML =
                '<p class="pick-hint">Hanya berlaku pada mode Garis. '
              + 'Mode Kontur selalu memakai warna per band dari skala warna.</p>';
            return;
        }

        this.el.lineSection.hidden = false;

        const isBarb   = layer.renderer === "windbarb";
        const palette  = isBarb ? BARB_SWATCHES : SWATCHES;
        const current  = () => layer.options.color || null;

        const swatches = document.createElement("div");
        swatches.className = "swatches";

        // "Otomatis" (warna per band dari skala warna) cuma masuk akal
        // untuk kontur/garis — barb tidak punya skala warna untuk
        // dikembalikan ke situ, jadi tombol ini tidak ditampilkan untuknya.
        let auto = null;
        if (!isBarb) {
            auto = document.createElement("button");
            auto.type = "button";
            auto.className = "swatch swatch--auto";
            auto.title = "Warna per band (mengikuti skala warna)";
            auto.textContent = "A";
        }

        const buttons = palette.map(c => {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "swatch";
            b.style.background = c;
            b.title = c;
            b._c = c;
            return b;
        });

        const custom = document.createElement("input");
        custom.type = "color";
        custom.className = "style-custom";
        custom.title = "Warna lain";

        const mark = () => {
            const c = current();
            auto?.classList.toggle("is-active", !c);
            buttons.forEach(b =>
                b.classList.toggle("is-active", !!c && b._c.toLowerCase() === c.toLowerCase()));
            custom.value = c || (isBarb ? "#1a1a1a" : "#1a1a1a");
        };

        const apply = c => {
            layer.setColor(c);
            mark();
            this.onChange?.();
        };

        auto?.addEventListener("click", () => apply(null));
        buttons.forEach(b => b.addEventListener("click", () => apply(b._c)));
        custom.addEventListener("input", () => apply(custom.value));

        swatches.append(...(auto ? [auto] : []), ...buttons);

        const field = document.createElement("div");
        field.className = "color-field";
        field.append(swatches, custom);

        wrap.appendChild(field);
        mark();
    }

    /** Kerapatan barb — jarak target antar simbol dalam piksel layar.
     *  Hanya relevan untuk windbarb; renderer lain tidak punya konsep
     *  ini (kontur/garis rapat mengikuti resolusi grid, bukan piksel). */
    renderDensity() {
        const wrap  = this.el.density;
        const layer = this.layer;
        wrap.innerHTML = "";

        if (layer.renderer !== "windbarb") {
            this.el.densitySection.hidden = true;
            return;
        }
        this.el.densitySection.hidden = false;

        const current = layer.options.targetPx || 28;
        const presets = [
            [18, "Rapat"],
            [28, "Sedang"],
            [40, "Jarang"],
        ];

        presets.forEach(([px, label]) => {
            const b = document.createElement("button");
            b.type        = "button";
            b.className   = "chip" + (current === px ? " is-active" : "");
            b.textContent = label;
            b.title       = `\u2248 ${px}px antar barb`;
            b.addEventListener("click", () => {
                layer.options.targetPx = px;
                layer.instance?.setDensity?.(px);
                [...wrap.children].forEach(c => c.classList.remove("is-active"));
                b.classList.add("is-active");
                this.onChange?.();
            });
            wrap.appendChild(b);
        });
    }

    /* ---- skala warna: simulasi tiap pilihan ---- */

    renderColorbars() {
        const wrap  = this.el.colorbars;
        const layer = this.layer;
        wrap.innerHTML = "";

        if (!layer.colorbars?.length) {
            wrap.innerHTML =
                '<p class="pick-hint">Parameter ini tidak punya pilihan skala warna.</p>';
            return;
        }

        layer.colorbars.forEach(name => {
            const cb = NWP.colorbars.get(name);
            if (!cb) return;

            const opt = document.createElement("button");
            opt.type      = "button";
            opt.className = "colorbar-option"
                           + (name === layer.colorbar ? " is-active" : "");
            if (cb.note) opt.title = cb.note;

            const bar = document.createElement("div");
            bar.className = "legend-bar";
            cb.colors.forEach(c => {
                const cell = document.createElement("span");
                cell.className = "legend-cell";
                cell.style.background = c;
                bar.appendChild(cell);
            });

            const label = document.createElement("div");
            label.className   = "colorbar-label";
            label.textContent = cb.label || name;

            const range = document.createElement("div");
            range.className   = "colorbar-range";
            range.textContent = `${cb.levels[0]} \u2013 ${cb.levels.at(-1)} ${cb.unit || ""}`;

            opt.append(bar, label, range);
            opt.addEventListener("click", () => {
                layer.setColorbar(name);
                this.renderColorbars();   // refresh status aktif
                this.onChange?.();
            });

            wrap.appendChild(opt);
        });
    }

    /* ---- ambang nilai: lebih dari / kurang dari / range ---- */

    renderThreshold() {
        const wrap  = this.el.threshold;
        const layer = this.layer;
        wrap.innerHTML = "";

        if (!layer.canSwitchDisplay) {
            wrap.innerHTML = '<p class="pick-hint">Tidak tersedia untuk layer ini.</p>';
            return;
        }

        const t = layer.threshold;

        const chips = document.createElement("div");
        chips.className = "chip-row";

        const inputs = document.createElement("div");
        inputs.className = "threshold-inputs";

        const minInput = document.createElement("input");
        minInput.type = "number"; minInput.step = "any";
        minInput.placeholder = "nilai";
        minInput.className = "threshold-num";
        if (t?.min != null) minInput.value = t.min;

        const maxInput = document.createElement("input");
        maxInput.type = "number"; maxInput.step = "any";
        maxInput.placeholder = t?.mode === "range" ? "sampai" : "nilai";
        maxInput.className = "threshold-num";
        if (t?.max != null) maxInput.value = t.max;

        const dash = document.createElement("span");
        dash.className   = "threshold-dash";
        dash.textContent = "\u2013";

        let mode = t?.mode || "none";

        const layout = () => {
            inputs.innerHTML = "";
            inputs.hidden = mode === "none";
            if (mode === "gt")    inputs.append(minInput);
            if (mode === "lt")    { maxInput.placeholder = "nilai"; inputs.append(maxInput); }
            if (mode === "range") {
                maxInput.placeholder = "sampai";
                inputs.append(minInput, dash, maxInput);
            }
        };

        const apply = () => {
            if (mode === "none") { layer.setThreshold(null); this.onChange?.(); return; }

            const min = minInput.value === "" ? null : Number(minInput.value);
            const max = maxInput.value === "" ? null : Number(maxInput.value);

            // Nilai belum lengkap (mis. baru mulai mengetik "-") — jangan
            // terapkan ambang yang tidak masuk akal sampai lengkap.
            if (mode === "gt"    && min == null) return;
            if (mode === "lt"    && max == null) return;
            if (mode === "range" && (min == null || max == null)) return;

            layer.setThreshold({ mode, min, max });
            this.onChange?.();
        };

        [["none", "Tidak ada"], ["gt", "Lebih dari"],
         ["lt", "Kurang dari"], ["range", "Range"]].forEach(([v, label]) => {
            const b = document.createElement("button");
            b.type        = "button";
            b.className   = "chip" + (mode === v ? " is-active" : "");
            b.textContent = label;
            b.addEventListener("click", () => {
                mode = v;
                [...chips.children].forEach(c => c.classList.remove("is-active"));
                b.classList.add("is-active");
                layout();
                apply();
            });
            chips.appendChild(b);
        });

        [minInput, maxInput].forEach(inp =>
            inp.addEventListener("input", () => apply()));

        layout();
        wrap.append(chips, inputs);
    }
}

/* ------------------------------------------------------------------ */
/* Popup gaya layer (warna, garis) untuk data statis / gambar / GPX    */
/* ------------------------------------------------------------------ */

class StylePicker {

    constructor(onChange) {
        this.onChange = onChange;
        this.layer    = null;

        this.el = {
            root        : document.getElementById("picker-style"),
            title       : document.getElementById("style-title"),
            color       : document.getElementById("style-color"),
            lineSection : document.getElementById("style-line-section"),
            line        : document.getElementById("style-line"),
            labelSection: document.getElementById("style-label-section"),
            label       : document.getElementById("style-label"),
        };

        bindModalClose(this.el.root, () => this.close());
    }

    open(layer) {
        this.layer = layer;
        this.el.title.textContent = `Gaya \u00b7 ${layer.title}`;

        this.renderColor();
        this.renderLine();
        this.renderLabel();

        this.el.root.hidden = false;
    }

    close() {
        this.el.root.hidden = true;
        this.layer = null;
    }

    renderColor() {
        const wrap  = this.el.color;
        const layer = this.layer;
        wrap.innerHTML = "";

        const swatches = document.createElement("div");
        swatches.className = "swatches";

        const buttons = SWATCHES.map(c => {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "swatch";
            b.style.background = c;
            b.title = c;
            b._c = c;
            swatches.appendChild(b);
            return b;
        });

        const custom = document.createElement("input");
        custom.type      = "color";
        custom.className = "style-custom";
        custom.title     = "Warna lain";

        const mark = () => {
            const c = layer.style.color.toLowerCase();
            buttons.forEach(b =>
                b.classList.toggle("is-active", b._c.toLowerCase() === c));
            custom.value = layer.style.color;
        };

        const apply = c => {
            layer.setStyle({ color: c });
            mark();
            this.onChange?.();
        };

        buttons.forEach(b => b.addEventListener("click", () => apply(b._c)));
        custom.addEventListener("input", () => apply(custom.value));

        const field = document.createElement("div");
        field.className = "color-field";
        field.append(swatches, custom);

        wrap.appendChild(field);
        mark();
    }

    renderLine() {
        const wrap  = this.el.line;
        const layer = this.layer;
        wrap.innerHTML = "";

        // GPX belum mendukung gaya garis selain warna — bukan cacat,
        // memang belum ada kebutuhannya.
        if (layer.kind !== "static") {
            this.el.lineSection.hidden = true;
            return;
        }
        this.el.lineSection.hidden = false;

        const dashRow = document.createElement("div");
        dashRow.className = "chip-row";
        [["solid", "\u2014\u2014\u2014"], ["dashed", "\u2013 \u2013 \u2013"],
         ["dotted", "\u00b7 \u00b7 \u00b7"]].forEach(([v, label]) => {
            const b = document.createElement("button");
            b.type        = "button";
            b.className   = "chip" + (layer.style.dash === v ? " is-active" : "");
            b.textContent = label;
            b.addEventListener("click", () => {
                layer.setStyle({ dash: v });
                [...dashRow.children].forEach(c => c.classList.remove("is-active"));
                b.classList.add("is-active");
                this.onChange?.();
            });
            dashRow.appendChild(b);
        });

        const weightRow = document.createElement("div");
        weightRow.className = "chip-row";
        [0.8, 1.2, 2, 3].forEach(v => {
            const b = document.createElement("button");
            b.type        = "button";
            b.className   = "chip" + (Number(layer.style.weight) === v ? " is-active" : "");
            b.textContent = `${v}px`;
            b.addEventListener("click", () => {
                layer.setStyle({ weight: v });
                [...weightRow.children].forEach(c => c.classList.remove("is-active"));
                b.classList.add("is-active");
                this.onChange?.();
            });
            weightRow.appendChild(b);
        });

        const fill = document.createElement("label");
        fill.className = "fill-check";
        const fcb = document.createElement("input");
        fcb.type    = "checkbox";
        fcb.checked = !!layer.style.fill;
        fcb.addEventListener("change", () => {
            layer.setStyle({ fill: fcb.checked });
            this.onChange?.();
        });
        fill.append(fcb, document.createTextNode("Poligon berisi"));

        wrap.append(dashRow, weightRow, fill);
    }

    /**
     * Field mana dari properti GeoJSON yang jadi teks label, dan
     * apakah sedang ditampilkan. Cuma untuk layer statis (kind==="static")
     * — GPX/lainnya belum punya kebutuhan ini, jadi bagian ini
     * disembunyikan untuk kind lain, bukan ditampilkan kosong.
     */
    renderLabel() {
        const wrap  = this.el.label;
        const layer = this.layer;
        wrap.innerHTML = "";

        if (layer.kind !== "static" || typeof layer.availableLabelFields !== "function") {
            this.el.labelSection.hidden = true;
            return;
        }

        const fields = layer.availableLabelFields();
        this.el.labelSection.hidden = false;

        if (!fields.length) {
            wrap.innerHTML =
                '<p class="pick-hint">Data ini tidak punya properti yang bisa '
              + 'dipakai sebagai label.</p>';
            return;
        }

        const select = document.createElement("select");
        const noneOpt = document.createElement("option");
        noneOpt.value = "";
        noneOpt.textContent = "Tidak ada";
        select.appendChild(noneOpt);
        fields.forEach(k => {
            const o = document.createElement("option");
            o.value = k;
            o.textContent = k;
            select.appendChild(o);
        });
        select.value = layer.labelField || "";

        const toggle = document.createElement("label");
        toggle.className = "fill-check";
        const cb = document.createElement("input");
        cb.type     = "checkbox";
        cb.checked  = layer.showLabel;
        cb.disabled = !layer.labelField;
        toggle.append(cb, document.createTextNode("Tampilkan di peta"));

        select.addEventListener("change", () => {
            layer.setLabelField(select.value);
            cb.disabled = !select.value;
            // Memilih field baru = maksudnya mau ditampilkan; kosongkan
            // field = otomatis matikan juga, supaya tidak ada kondisi
            // "field terisi tapi checkbox lupa dinyalakan sebelumnya".
            cb.checked = !!select.value;
            layer.setShowLabel(cb.checked);
            this.onChange?.();
        });

        cb.addEventListener("change", () => {
            layer.setShowLabel(cb.checked);
            this.onChange?.();
        });

        wrap.append(select, toggle);
    }
}

