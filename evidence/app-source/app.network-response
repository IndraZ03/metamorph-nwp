            b.textContent = g;
            b.addEventListener("click", () => this.pickGroup(g));
            b._g = g;
            this.el.groups.appendChild(b);
        });

        if (groups.length) this.pickGroup(groups[0]);
        return this.catalog;
    }

    pickGroup(g) {
        [...this.el.groups.children].forEach(b =>
            b.classList.toggle("is-active", b._g === g));

        this.el.list.innerHTML = "";
        this.catalog.sources
            .filter(s => (s.group || "Lainnya") === g)
            .forEach(src => {
                const b = document.createElement("button");
                b.type = "button";
                b.className = "chip";
                b.textContent = src.label;
                b.addEventListener("click", () => this.select(src));
                b._src = src;
                this.el.list.appendChild(b);
            });

        this.pick = null;
        this.el.add.disabled = true;
        this.el.hint.textContent = "Pilih produk.";
        this.el.note.textContent = "";
    }

    select(src) {
        this.pick = src;
        [...this.el.list.children].forEach(b =>
            b.classList.toggle("is-active", b._src === src));

        this.el.hint.textContent = src.label;
        this.el.opacity.value = String(src.opacity ?? 1);

        // Rentang zoom penting disebut: di luar itu tile tidak tersedia
        // dan Leaflet akan merentangkan tile terakhir.
        this.el.note.textContent =
            `Zoom ${src.min_zoom}\u2013${src.max_zoom} \u00b7 `
          + `tiap ${src.step_minutes} menit \u00b7 `
          + `${src.history_hours} jam terakhir. `
          + `Menambahkan ini membuat timeline turun ke resolusi `
          + `${src.step_minutes} menit; layer NWP akan membeku di jam bulat.`;

        this.el.add.disabled = false;
    }

    open()  { this.el.root.hidden = false; }
    close() { this.el.root.hidden = true; }

    add() {
        if (!this.pick) return;
        this.onAdd({ ...this.pick, opacity: Number(this.el.opacity.value) });
    }
}

