/* App                                                                 */
/* ------------------------------------------------------------------ */

class App {

    constructor() {
        this.el = {
            status: document.getElementById("status"),
            valid : document.getElementById("valid-line"),
            layers: document.getElementById("layers"),
            empty : document.getElementById("layer-empty"),
            legend: document.getElementById("legend"),
        };

        this.map = L.map("map", { zoomControl: true })
                    .setView(APP.center.latlng, APP.center.zoom);
        L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}", {
            attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ',
            maxZoom: 16
        }).addTo(this.map);

        this.layers = [];   // urutan tampil: index 0 = paling atas
        this.indexCache = new Map();   // indexUrl -> Promise(INDEX)

        // Layer yang lagi menunggu "diganti datanya" (switchData()) —
        // diisi tepat sebelum popup Add kategori terkait dibuka, dibaca
        // (dan dikosongkan lagi) oleh insertOrReplace() saat Add ditekan.
        // Tombol Add BIASA (bukan lewat switchData) selalu mengosongkan
        // ini duluan, supaya switch yang dibatalkan tidak diam-diam
        // "nempel" ke Add berikutnya yang tidak ada hubungannya.
        this.switchingLayer = null;

        // Debounce: banyak aksi (termasuk tiap step saat play berjalan)
        // bisa memicu ini beruntun. localStorage.setItem itu sinkron dan
        // memblokir thread utama, jadi ditulis paling cepat 1.5 detik
        // sekali, bukan setiap kali dipanggil.
        this._saveTimer = null;

        this.timebar = new TimeBar(
            document.getElementById("timebar-strip"),
            iso => this.showTime(iso)
        );

        this.picker = new Picker(
            new URL(APP.catalog, location.href).href,
            spec => this.addLayer(spec)
        );

        this.tilePicker = new TilePicker(
            APP.tileCatalog,
            spec => this.addTile(spec)
        );

        this.radarPicker = new RadarPicker(
            APP.radarCatalog,
            spec => this.addRadar(spec)
        );

        this.ef5Picker = new Ef5Picker(
            APP.ef5Catalog,
            spec => this.addEf5(spec)
        );

        // Popup pengaturan tampilan (skala warna, ambang, kontur/garis)
        // bekerja di atas layer yang sudah ada di peta, jadi tidak
        // menerima spec seperti picker lain — cukup gambar ulang kartu
        // dan legenda saat sesuatu berubah.
        this.settingsPicker = new SettingsPicker(() => {
            this.renderCards();
            this.renderLegends();
            this.scheduleSave();
        });

        // Popup gaya untuk data statis/gambar/GPX — pola yang sama
        // dengan settingsPicker, hanya targetnya layer.setStyle().
        this.stylePicker = new StylePicker(() => {
            this.renderCards();
            this.renderLegends();
            this.scheduleSave();
        });

        this.staticPicker = new StaticPicker(
            APP.staticCatalog,
            spec => this.addStatic(spec)
        );

        this.gpxPicker = new GpxPicker(spec => this.addGpx(spec));
        document.getElementById("btn-add-gpx").addEventListener("click", () => {
            this.switchingLayer = null;   // Add biasa, bukan lanjutan switchData()
            this.gpxPicker.open();
        });

        document.getElementById("btn-add")
            .addEventListener("click", () => {
                this.switchingLayer = null;
                this.picker.open();
            });

        document.getElementById("btn-add-tile")
            .addEventListener("click", () => {
                this.switchingLayer = null;
                this.tilePicker.open();
            });

        document.getElementById("btn-add-radar")
            .addEventListener("click", () => {
                this.switchingLayer = null;
                this.radarPicker.open();
            });

        document.getElementById("btn-add-ef5")
            .addEventListener("click", () => {
                this.switchingLayer = null;
                this.ef5Picker.open();
            });

        document.getElementById("btn-add-static")
            .addEventListener("click", () => {
                this.switchingLayer = null;
                this.staticPicker.open();
            });

        this.bindCollapse();
        this.bindDrawTools();
    }

    /**
     * Alat gambar selalu tersedia; layer "Gambar" dibuat otomatis saat
     * bentuk pertama dibuat, supaya tidak perlu dua langkah hanya untuk
     * menandai satu area.
     */
    bindDrawTools() {
        this.drawHint = document.getElementById("draw-hint");

        const HINTS = {
            rect  : "Seret untuk membuat kotak. Esc untuk batal.",
            circle: "Seret dari titik pusat. Esc untuk batal.",
            line  : "Klik tiap titik, Enter untuk selesai. Esc untuk batal.",
        };

        this.drawButtons = [...document.querySelectorAll(".draw-btn[data-mode]")];

        this.drawButtons.forEach(b => {
            b.addEventListener("click", () => {
                const layer = this.ensureDrawLayer();
                const mode  = layer.setMode(b.dataset.mode);

                this.drawButtons.forEach(x =>
                    x.classList.toggle("is-active", x.dataset.mode === mode));

                this.drawHint.hidden = !mode;
                if (mode) this.drawHint.textContent = HINTS[mode];
            });
        });

        document.getElementById("draw-clear").addEventListener("click", () => {
            const l = this.layers.find(x => x.kind === "draw");
            if (l) { l.clear(); this.removeLayer(l.uid); }
            this.drawButtons.forEach(x => x.classList.remove("is-active"));
            this.drawHint.hidden = true;
        });
    }

    ensureDrawLayer() {
        let layer = this.layers.find(l => l.kind === "draw");
        if (layer) return layer;

        layer = new NWP.DrawLayer(this.map, `D${++uidSeq}`);
        layer.mount();

        // Kartu dibuat ulang tiap kali jumlah bentuk berubah supaya
        // hitungannya di judul dan legenda tetap benar.
        layer.onChange = () => {
            if (!layer.count) {
                this.removeLayer(layer.uid);   // removeLayer() sudah scheduleSave()
                this.drawButtons.forEach(x => x.classList.remove("is-active"));
                this.drawHint.hidden = true;
                return;
            }
            this.renderCards();
            this.renderLegends();
            this.scheduleSave();
        };

        layer.onModeChange = mode => {
            this.drawButtons.forEach(x =>
                x.classList.toggle("is-active", x.dataset.mode === mode));
            this.drawHint.hidden = !mode;
        };

        this.layers.unshift(layer);
        this.renderCards();
        this.applyOrder();
        return layer;
    }

    bindCollapse() {
        document.querySelectorAll(".panel-toggle").forEach(btn => {
            btn.addEventListener("click", () => {
                const body = document.getElementById(btn.dataset.target);
                const now  = body.classList.toggle("is-collapsed");
                btn.textContent = now ? "+" : "\u2212";
                btn.setAttribute("aria-expanded", String(!now));
            });
        });
    }

    async start() {
        this.el.status.textContent = "Memuat katalog\u2026";

        // Harus selesai sebelum layer pertama dibuat: gaya diselesaikan
        // di konstruktor Layer, dan tanpa katalog ini semua parameter
        // yang memakai nama colorbar akan jatuh ke warna bawaan renderer.
        try {
            const n = await NWP.colorbars.load(APP.colorbars);
            console.info(`${n} skala warna dimuat`);
        } catch (e) {
            console.warn("Katalog skala warna tidak dimuat:", e);
        }
        try {
            await this.picker.load();
        } catch (e) {
            this.el.status.textContent =
                `Katalog tidak bisa dimuat (${e.message}). Cek "catalog" di `
                + `meta/parameters.json dan header CORS di server data.`;
            console.error(e);
            return;
        }

        if (!this.picker.catalog.models?.length) {
            this.el.status.textContent = "Katalog kosong — belum ada data.";
            return;
        }

        this.picker.buildModels();

        // Katalog tile opsional, sama seperti katalog statis.
        try {
            const c = await this.tilePicker.load();
            this.startTileRefresh(c.refresh_seconds ?? 600);
        } catch (e) {
            console.warn("Katalog tile tidak dimuat:", e);
            const b = document.getElementById("btn-add-tile");
            b.disabled = true;
            b.title = "meta/satellite.json tidak ditemukan";
        }

        // Katalog radar opsional, sama seperti yang lain.
        try {
            await this.radarPicker.load();
        } catch (e) {
            console.warn("Katalog radar tidak dimuat:", e);
            const b = document.getElementById("btn-add-radar");
            b.disabled = true;
            b.title = "meta/radar.json tidak ditemukan";
        }

        // Katalog EF5 opsional juga.
        try {
            await this.ef5Picker.load();
        } catch (e) {
            console.warn("Katalog EF5 tidak dimuat:", e);
            const b = document.getElementById("btn-add-ef5");
            b.disabled = true;
            b.title = "meta/ef5.json tidak ditemukan";
        }

        // Katalog statis opsional: kalau tidak ada, tombolnya dimatikan
        // tapi seluruh aplikasi tetap jalan.
        try {
            await this.staticPicker.load();
        } catch (e) {
            console.warn("Katalog statis tidak dimuat:", e);
            const b = document.getElementById("btn-add-static");
            b.disabled = true;
            b.title = "meta/static.json tidak ditemukan";
        }

        this.el.status.textContent = "\u00a0";

        const saved = loadPersisted();
        if (saved) {
            await this.restoreState(saved);
        } else {
            this.renderCards();
        }
    }

    /** INDEX dipakai bersama beberapa layer dari produk yang sama. */
    loadIndex(url) {
        if (!this.indexCache.has(url)) {
            this.indexCache.set(url, fetch(bust(url), { cache: "no-store" })
                .then(r => {
                    if (!r.ok) throw new Error(`${r.status} INDEX`);
                    return r.json();
                }));
        }
        return this.indexCache.get(url);
    }

    /* ---- tambah / hapus layer ---- */

    /** Dipanggil tombol "ganti data" di kartu layer — buka ulang popup
     *  Add kategori yang sesuai, tapi Add berikutnya akan MENGGANTIKAN
     *  layer ini (posisi susun & opasitas dipertahankan), bukan
     *  menambah layer baru di atas seperti Add biasa. */
    switchData(layer) {
        const pickerByKind = {
            nwp    : this.picker,
            radar  : this.radarPicker,
            tile   : this.tilePicker,
            static : this.staticPicker,
            gpx    : this.gpxPicker,
            geotiff: this.ef5Picker,
        };
        const picker = pickerByKind[layer.kind];
        if (!picker) return;   // kind ini tidak punya popup Add (mis. draw)

        this.switchingLayer = layer;
        picker.open();
    }

    /** Dipakai SEMUA addXxx() menggantikan this.layers.unshift(layer)
     *  langsung — kalau this.switchingLayer terisi (Add ini datang dari
     *  switchData(), bukan tombol Add biasa), layer lama diganti DI
     *  POSISI YANG SAMA dan dibuang lewat destroy(); kalau tidak, layer
     *  baru ditambah di atas seperti biasa. */
    insertOrReplace(layer) {
        const old = this.switchingLayer;
        this.switchingLayer = null;

        if (old && this.layers.includes(old)) {
            layer.setOpacity(old.opacity);
            const idx = this.layers.indexOf(old);
            old.destroy();
            this.layers.splice(idx, 1, layer);
        } else {
            this.layers.unshift(layer);   // layer terbaru di atas
        }
    }

    async addLayer(spec) {
        this.picker.close();
        this.el.status.textContent = "Memuat data\u2026";

        let manifestUrl;
        try {
            const ix  = await this.loadIndex(spec.indexUrl);
            const run = ix.runs.find(r => r.init_time === spec.init);
            if (!run) throw new Error(`run ${spec.init} tidak ada di INDEX`);
            manifestUrl = run.manifest;
        } catch (e) {
            this.el.status.textContent = `Gagal menambah layer: ${e.message}`;
            return;
        }

        const layer = new Layer(spec, this.map);

        try {
            await layer.loadRun(manifestUrl);
        } catch (e) {
            layer.destroy();
            this.el.status.textContent = `Manifest gagal dimuat: ${e.message}`;
            return;
        }

        layer.mount();
        this.insertOrReplace(layer);      // layer terbaru di atas, atau gantikan kalau lagi switchData()

        if (!this.fitted && layer.manifest) {
            const b = layer.manifest.bounds;
            this.map.fitBounds([[b.la1, b.lo1], [b.la2, b.lo2]]);
            this.fitted = true;
        }

        this.renderCards();
        this.applyOrder();
        this.renderLegends();
        this.rebuildTimeline();
        this.scheduleSave();
    }

    async addTile(spec) {
        this.tilePicker.close();

        const layer = new NWP.TileLayer(spec, this.map, `T${++uidSeq}`);
        layer.mount();
        this.insertOrReplace(layer);

        this.renderCards();
        this.applyOrder();
        this.renderLegends();
        this.rebuildTimeline();
        this.scheduleSave();
    }

    async addRadar(spec) {
        this.radarPicker.close();
        this.el.status.textContent = "Memuat manifest radar\u2026";

        const layer = new NWP.RadarLayer(spec, this.map, `R${++uidSeq}`);

        try {
            await layer.load();
        } catch (e) {
            layer.destroy();
            this.el.status.textContent =
                `Radar ${spec.code} gagal dimuat: ${e.message}`;
            return;
        }

        if (!layer.times.length) {
            layer.destroy();
            this.el.status.textContent =
                `Radar ${spec.code}: history di manifest kosong.`;
            return;
        }

        layer.mount();
        this.insertOrReplace(layer);

        if (!this.fitted && layer.bounds) {
            this.map.fitBounds(layer.bounds);
            this.fitted = true;
        }

        this.renderCards();
        this.applyOrder();
        this.renderLegends();
        this.rebuildTimeline();
        this.el.status.textContent = "\u00a0";
        this.scheduleSave();
    }

    async addEf5(spec) {
        this.ef5Picker.close();
        this.el.status.textContent = `Memuat manifest ${spec.label}\u2026`;

        const layer = new NWP.GeoTiffLayer(spec, this.map, `E${++uidSeq}`);

        try {
            await layer.load();   // muat MANIFEST, bangun byTime — bukan
                                  // satu file .tif langsung lagi.
        } catch (e) {
            layer.destroy();
            this.el.status.textContent = `Gagal memuat ${spec.manifestUrl}: ${e.message}`;
            return;
        }

        if (!layer.byTime.size) {
            layer.destroy();
            this.el.status.textContent = `${spec.label}: manifest tidak punya step.`;
            return;
        }

        layer.mount();   // sengaja tidak membuat instance apa pun (lihat
                         // komentar di geotiff-layer.js) — instance
                         // sungguhan baru muncul lewat show() di bawah,
                         // dipicu rebuildTimeline().
        this.insertOrReplace(layer);

        // layer.bounds() butuh instance Leaflet yang belum tentu ada di
        // titik ini (baru dibuat show() nanti) — pakai bounds dari
        // MANIFEST langsung, tidak perlu menunggu render pertama.
        const mb = layer.manifest.bounds;
        if (!this.fitted && mb) {
            this.map.fitBounds([[mb.south, mb.west], [mb.north, mb.east]]);
            this.fitted = true;
        }

        this.renderCards();
        this.applyOrder();
        this.renderLegends();
        // hasTime=true sekarang — ini yang membuat rebuildTimeline()
        // ikut memasukkan valid_time milik layer ini ke union timeline,
        // dan otomatis memicu show() pertama lewat selectNearest().
        this.rebuildTimeline();
        this.el.status.textContent = "\u00a0";
        this.scheduleSave();   // EF5 belum didukung serializeLayer() —
                               // dipanggil tetap, layer lain yg sudah
                               // ada tetap tersimpan seperti biasa.
    }

    async addGpx(spec) {
        this.el.status.textContent = "Memuat rute GPX\u2026";
        const layer = new NWP.GpxLayer(spec, this.map, `G${++uidSeq}`);
        
        await layer.load();
        layer.mount();
        this.insertOrReplace(layer);

        this.renderCards();
        this.applyOrder();
        this.renderLegends();
        if (layer.hasTime) this.rebuildTimeline();
        
        this.el.status.textContent = "\u00a0";
    }

    /**
     * Jendela waktu satelit bergerak terus, jadi daftar baserun harus
     * diperbarui berkala. Timeline dibangun ulang hanya kalau memang ada
     * baserun baru, supaya tidak mengganggu saat pengguna sedang menonton.
     */
    startTileRefresh(seconds) {
        // refresh() satelit sinkron, radar async (ambil manifest lagi);
        // Promise.all menyamakan keduanya.
        setInterval(async () => {
            const tiles = this.layers.filter(l => typeof l.refresh === "function");
            if (!tiles.length) return;

            const changed = await Promise.all(tiles.map(l => l.refresh()));
            if (changed.some(Boolean)) this.rebuildTimeline();
        }, Math.max(60, seconds) * 1000);
    }

    async addStatic(spec) {
        this.staticPicker.close();
        this.el.status.textContent = "Memuat data statis\u2026";

        const layer = new NWP.StaticLayer(spec, this.map, `S${++uidSeq}`);

        try {
            await layer.load();
        } catch (e) {
            layer.destroy();
            this.el.status.textContent = `Gagal memuat ${spec.file}: ${e.message}`;
            return;
        }

        layer.mount();
        this.insertOrReplace(layer);

        // Batas admin biasanya ditambahkan sebagai konteks, bukan sebagai
        // subjek, jadi jangan geser peta kalau sudah ada layer lain.
        if (!this.fitted) {
            const b = layer.bounds();
            if (b) { this.map.fitBounds(b); this.fitted = true; }
        }

        this.renderCards();
        this.applyOrder();
        this.renderLegends();
        this.el.status.textContent = "\u00a0";
        this.scheduleSave();
    }

    removeLayer(uid) {
        const i = this.layers.findIndex(l => l.uid === uid);
        if (i < 0) return;

        // Layer gambar mungkin sedang dalam mode menggambar; destroy()
        // memanggil setMode(null) yang mengembalikan drag peta.
        this.layers[i].destroy();
        this.layers.splice(i, 1);

        this.renderCards();
        this.applyOrder();
        this.renderLegends();
        this.rebuildTimeline();
        this.scheduleSave();
    }

    /* ---- simpan / pulihkan state ---- */

    scheduleSave() {
        clearTimeout(this._saveTimer);
        this._saveTimer = setTimeout(() => this.saveState(), 1500);
    }

    /** null kalau layer ini tidak punya cara aman untuk dipulihkan
     *  (upload manual, GPX) — lihat catatan di loadPersisted(). */
    serializeLayer(layer) {
        const base = { kind: layer.kind, opacity: layer.opacity, on: layer.on };

        switch (layer.kind) {
            case "nwp":
                return {
                    ...base,
                    spec       : layer.spec,
                    colorbar   : layer.colorbar,
                    threshold  : layer.threshold,
                    displayMode: layer.canSwitchDisplay ? layer.displayMode : null,
                    color      : layer.options.color ?? null,
                    smooth     : layer.options.smooth ?? false,
                };

            case "static":
                if (!layer.spec.id) return null;   // upload manual: lewati
                return { ...base, catalogId: layer.spec.id, style: layer.style };

            case "tile":
                if (!layer.spec.id) return null;
                return { ...base, catalogId: layer.spec.id };

            case "radar":
                return { ...base, catalogId: layer.spec.code };

            case "draw":
                return layer.count
                    ? { ...base, geojson: layer.toGeoJSON(), style: layer.style }
                    : null;   // kosong, tidak perlu disimpan

            default:   // gpx — lihat catatan di loadPersisted()
                return null;
        }
    }

    saveState() {
        const layers = this.layers
            .map(l => this.serializeLayer(l))
            .filter(Boolean)
            .reverse();   // this.layers[0] = teratas; simpan urutan tampil alami

        writePersisted({
            version: STORAGE_VERSION,
            savedAt: new Date().toISOString(),
            currentTime: this.currentTime || null,
            layers,
        });
    }

    /**
     * Dipanggil sekali di akhir start(), setelah semua katalog siap.
     * Tiap entri dibangun ulang lewat jalur yang SAMA dengan menambah
     * layer secara manual (addLayer/addStatic/dst), supaya tidak ada
     * logika ganda — kalau nanti jalur itu berubah, pemulihan ikut benar
     * tanpa perlu disentuh terpisah.
     */
    async restoreState(state) {
        if (!state?.layers?.length) return;

        let skipped = 0;

        // add*() bisa gagal diam-diam (run sudah dihapus dari server,
        // manifest error) dan berhenti lebih awal TANPA menambah apa pun
        // ke this.layers. Membandingkan panjang array sebelum/sesudah
        // adalah cara amannya untuk tahu apakah layer benar-benar
        // bertambah — mengambil this.layers[0] begitu saja berisiko
        // menimpa state ke layer lain yang sudah ada sebelumnya.
        const justAdded = () =>
            this.layers.length > lenBefore ? this.layers[0] : null;

        let lenBefore;

        for (const entry of state.layers) {
            try {
                if (entry.kind === "nwp") {
                    lenBefore = this.layers.length;
                    await this.addLayer(entry.spec);
                    const layer = justAdded();
                    if (!layer) { skipped++; continue; }

                    layer.opacity = entry.opacity;
                    layer.on      = entry.on;
                    if (entry.colorbar)  layer.setColorbar(entry.colorbar);
                    if (entry.threshold) layer.setThreshold(entry.threshold);
                    if (entry.displayMode && entry.displayMode !== layer.displayMode) {
                        layer.setDisplayMode(entry.displayMode);
                    }
                    if (entry.color) layer.setColor(entry.color);
                    if (entry.smooth) layer.setSmooth(true);
                    if (!layer.on) layer.unmount();
                    layer.instance?.setOpacity?.(entry.opacity);
                    layer.pane.style.opacity = String(entry.opacity);

                } else if (entry.kind === "static") {
                    const found = this.staticPicker.catalog?.data
                        ?.find(d => d.id === entry.catalogId);
                    if (!found) { skipped++; continue; }

                    lenBefore = this.layers.length;
                    await this.addStatic({ ...found, style: entry.style ?? found.style });
                    const layer = justAdded();
                    if (!layer) { skipped++; continue; }
                    layer.opacity = entry.opacity;
                    layer.on      = entry.on;

                } else if (entry.kind === "tile") {
                    const found = this.tilePicker.catalog?.sources
                        ?.find(d => d.id === entry.catalogId);
                    if (!found) { skipped++; continue; }

                    lenBefore = this.layers.length;
                    await this.addTile({ ...found, opacity: entry.opacity });
                    const layer = justAdded();
                    if (!layer) { skipped++; continue; }
                    layer.on = entry.on;

                } else if (entry.kind === "radar") {
                    const spec = this.radarPicker.findSpec(entry.catalogId);
                    if (!spec) { skipped++; continue; }

                    lenBefore = this.layers.length;
                    await this.addRadar({ ...spec, opacity: entry.opacity });
                    const layer = justAdded();
                    if (!layer) { skipped++; continue; }
                    layer.on = entry.on;

                } else if (entry.kind === "draw") {
                    const layer = this.ensureDrawLayer();
                    layer.fromGeoJSON(entry.geojson);
                    if (entry.style) layer.setStyle(entry.style);
                    layer.opacity = entry.opacity;
                    layer.on      = entry.on;
                    layer.pane.style.opacity = String(entry.opacity);
                    if (!entry.on) layer.unmount();
                    this.renderCards();
                    this.applyOrder();
                    this.renderLegends();
                }
            } catch (e) {
                console.warn(`Gagal memulihkan layer ${entry.kind}:`, e);
                skipped++;
            }
        }

        // this.layers sekarang terurut terbalik dari state.layers (tiap
        // add* menaruh yang baru di posisi teratas). Kembalikan ke urutan
        // tampil yang tersimpan, alih-alih menuliskan ulang semua add*
        // agar dukung "push" — ini titik singgungnya cukup satu tempat.
        const order = state.layers.map(e =>
            e.kind === "static" ? e.catalogId
          : e.kind === "tile"   ? e.catalogId
          : e.kind === "radar"  ? e.catalogId
          : e.kind === "draw"   ? "draw"
          : e.spec?.init + e.spec?.parameter + e.spec?.level);

        this.layers.sort((a, b) => {
            const keyOf = l => l.kind === "nwp"
                ? l.spec.init + l.spec.parameter + l.spec.level
                : (l.spec?.id ?? l.spec?.code ?? "draw");
            return order.indexOf(keyOf(a)) - order.indexOf(keyOf(b));
        });
        this.applyOrder();
        this.renderCards();
        this.renderLegends();

        if (state.currentTime) this.timebar.selectNearest(state.currentTime);

        if (skipped) {
            this.el.status.textContent =
                `${skipped} layer tersimpan tidak bisa dipulihkan `
              + `(datanya sudah tidak ada di katalog).`;
        }
    }

    /* ---- panel layer ---- */

    renderCards() {
        this.el.layers.innerHTML = "";
        this.el.empty.hidden = this.layers.length > 0;

        this.layers.forEach(layer => {
            const card = document.createElement("div");
            // Kelas visual kartu ditentukan sepenuhnya oleh kind — satu
            // properti, satu sumber kebenaran, bukan lima flag yang bisa
            // saling tumpang tindih.
            const KIND_CARD_CLASS = {
                static : "layer-card--static",
                gpx    : "layer-card--static",  // GPX pakai gaya kartu statis
                radar  : "layer-card--radar",
                tile   : "layer-card--tile",
                draw   : "layer-card--draw",
                geotiff: "layer-card--static",  // sama alasannya dgn GPX di atas
            };
            card.className = "layer-card"
                + (KIND_CARD_CLASS[layer.kind] ? ` ${KIND_CARD_CLASS[layer.kind]}` : "");
            card.draggable = true;
            card.dataset.uid = layer.uid;
            if (!layer.on) card.classList.add("is-off");

            const head = document.createElement("div");
            head.className = "layer-head";

            const grip = document.createElement("span");
            grip.className = "layer-grip";

            const gripIcon = document.createElement("img");
            gripIcon.src = "assets/grip.svg";
            gripIcon.alt = "Drag layer";
            gripIcon.style.width = "10px";
            gripIcon.style.height = "16px";
            gripIcon.style.opacity = "0.5";
            gripIcon.style.pointerEvents = "none";

            grip.appendChild(gripIcon);

            const title = document.createElement("div");
            title.className = "layer-title";

            const name = document.createElement("span");
            name.className   = "layer-name";
            name.textContent = layer.title;
            name.title       = layer.spec.long_name || layer.title;

            const origin = document.createElement("span");
            origin.className   = "layer-origin";
            origin.textContent = layer.origin;
            // Sebelumnya rantai ini tidak punya cabang untuk GPX, jadi
            // tooltip-nya jatuh ke default NWP dan mencoba membaca
            // layer.spec.init yang tidak ada pada GPX — menghasilkan
            // "Run Invalid Date". Sekarang satu lookup per kind, dan kind
            // yang tidak disebut (NWP) jatuh ke default run time.
            const KIND_TOOLTIP = {
                draw   : "Klik kanan sebuah bentuk untuk menghapusnya",
                static : layer.spec.file,
                gpx    : layer.title,
                radar  : layer.spec.manifest,
                tile   : layer.spec.url?.split("?")[0],
                geotiff: layer.spec.url,
            };
            origin.title = KIND_TOOLTIP[layer.kind]
                ?? `Run ${NWP.time.full(layer.spec.init)}`;

            title.append(name, origin);

            // Pengaturan tampilan (skala warna, ambang, kontur/garis) —
            // hanya untuk layer yang renderernya bisa itu (kontur/garis).
            // Ditaruh sebelum tombol tampil/hapus karena sifatnya
            // konfigurasi, bukan aksi terhadap keberadaan layer itu sendiri.
            // Satu tombol gear, dua kemungkinan popup: pengaturan tampilan
            // untuk SEMUA layer NWP (kontur, garis, DAN barb — kartu tidak
            // perlu tahu rendererable-nya yang mana, cukup kind === "nwp"),
            // gaya untuk data statis/gambar/GPX. Keduanya tidak pernah
            // berlaku bersamaan pada layer yang sama.
            const settingsTarget = layer.kind === "nwp" ? "nwp"
                                  : (layer.kind === "static" || layer.kind === "gpx") ? "style"
                                  : null;

            let btnSettings = null;
            if (settingsTarget) {
                btnSettings = document.createElement("button");
                btnSettings.type = "button";
                btnSettings.className = "layer-drop layer-drop--muted";
                btnSettings.title = settingsTarget === "nwp"
                    ? "Pengaturan tampilan" : "Gaya layer";
                btnSettings.setAttribute("aria-label", `${btnSettings.title} ${layer.title}`);

                const gearIcon = document.createElement("img");
                gearIcon.src = "assets/setting-slider.svg";
                gearIcon.alt = "";
                gearIcon.style.width = "15px";
                gearIcon.style.height = "15px";
                gearIcon.style.opacity = "0.7";
                btnSettings.appendChild(gearIcon);

                btnSettings.addEventListener("click", () => {
                    if (settingsTarget === "nwp") this.settingsPicker.open(layer);
                    else                          this.stylePicker.open(layer);
                });
            }

            // Ganti data — buka ulang popup Add kategori ini, Add
            // berikutnya menggantikan layer ini (bukan menambah baru).
            // Cuma untuk kind yang punya popup Add (lihat switchData());
            // "draw" misalnya tidak, jadi tombolnya tidak dibuat sama
            // sekali untuk itu — bukan ditampilkan lalu dinonaktifkan.
            const SWITCHABLE_KINDS = new Set(
                ["nwp", "radar", "tile", "static", "gpx", "geotiff"]);

            let btnSwitch = null;
            if (SWITCHABLE_KINDS.has(layer.kind)) {
                btnSwitch = document.createElement("button");
                btnSwitch.type = "button";
                btnSwitch.className = "layer-drop layer-drop--muted";
                btnSwitch.title = "Ganti data";
                btnSwitch.setAttribute("aria-label", `Ganti data ${layer.title}`);

                const switchIcon = document.createElement("img");
                switchIcon.src = "assets/change-data.svg";
                switchIcon.alt = "";
                switchIcon.style.width = "15px";
                switchIcon.style.height = "15px";
                switchIcon.style.opacity = "0.7";
                btnSwitch.appendChild(switchIcon);

                btnSwitch.addEventListener("click", () => this.switchData(layer));
            }

            // Tampil / sembunyi
            const btnVis = document.createElement("button");
            btnVis.type = "button";
            btnVis.className = "layer-drop layer-drop--muted";
            btnVis.title = "Tampilkan layer";

            const visIcon = document.createElement("img");
            visIcon.src = layer.on ? "assets/eye.svg" : "assets/eye-crossed.svg";
            visIcon.alt = "";
            visIcon.style.width = "16px";
            visIcon.style.height = "16px";
            visIcon.style.opacity = "0.7";
            btnVis.appendChild(visIcon);

            btnVis.addEventListener("click", () => {
                layer.on = !layer.on;
                visIcon.src = layer.on ? "assets/eye.svg" : "assets/eye-crossed.svg";

                card.classList.toggle("is-off", !layer.on);
                if (layer.on) {
                    layer.mount();
                    this.applyOrder();
                    if (layer.hasTime && this.currentTime) {
                        this.showTime(this.currentTime);
                    }
                } else {
                    layer.unmount();
                }
                this.renderLegends();
                this.timebar.markPartial(t => this.countAt(t));
                this.scheduleSave();
            });

            // Hapus
            const del = document.createElement("button");
            del.type = "button";
            del.className = "layer-drop";
            del.title = "Hapus layer";
            del.setAttribute("aria-label", `Hapus ${layer.title}`);

            const trashIcon = document.createElement("img");
            trashIcon.src = "assets/trash.svg";
            trashIcon.alt = "";
            trashIcon.style.width = "14px";
            trashIcon.style.height = "14px";
            trashIcon.style.opacity = "0.7";
            del.appendChild(trashIcon);

            del.addEventListener("click", () => this.removeLayer(layer.uid));

            head.append(grip, title,
                       ...(btnSettings ? [btnSettings] : []),
                       ...(btnSwitch ? [btnSwitch] : []),
                       btnVis, del);

            const op = document.createElement("div");
            op.className = "layer-opacity";

            const range = document.createElement("input");
            range.type = "range";
            range.min = "0"; range.max = "1"; range.step = "0.05";
            range.value = String(layer.opacity);

            const out = document.createElement("output");
            out.textContent = Math.round(layer.opacity * 100) + "%";

            range.addEventListener("input", () => {
                layer.setOpacity(Number(range.value));
                out.textContent = Math.round(range.value * 100) + "%";
                this.scheduleSave();
            });
            // Slider dan drag-to-reorder sama-sama memakai pointer; tanpa ini
            // menggeser slider akan ikut menyeret kartunya.
            range.addEventListener("pointerdown", () => { card.draggable = false; });
            range.addEventListener("pointerup",   () => { card.draggable = true;  });

            const opIcon = document.createElement("img");
            opIcon.src = "assets/icon-opacity.svg";
            opIcon.alt = "Opasitas";
            opIcon.title = "Opasitas";
            opIcon.style.width = "14px";
            opIcon.style.height = "14px";
            opIcon.style.opacity = "0.7";

            op.append(opIcon, range, out);

            card.append(head, op);

            // Warna dan kerapatan barb, warna+skala kontur/garis, gaya
            // data statis/GPX — semuanya sekarang di popup pengaturan
            // (tombol gear), bukan di kartu. Kartu sengaja tetap cuma
            // opasitas + tombol tampil/hapus/pengaturan.
            this.bindDrag(card);
            this.el.layers.appendChild(card);
        });
    }

    bindDrag(card) {
        card.addEventListener("dragstart", e => {
            this.dragUid = card.dataset.uid;
            card.classList.add("is-dragging");
            e.dataTransfer.effectAllowed = "move";
            e.dataTransfer.setData("text/plain", card.dataset.uid);
        });

        card.addEventListener("dragend", () => {
            card.classList.remove("is-dragging");
            this.el.layers.querySelectorAll(".layer-card")
                .forEach(c => c.classList.remove("is-over"));
        });

        card.addEventListener("dragover", e => {
            e.preventDefault();
            if (card.dataset.uid !== this.dragUid) card.classList.add("is-over");
        });

        card.addEventListener("dragleave", () => card.classList.remove("is-over"));

        card.addEventListener("drop", e => {
            e.preventDefault();
            card.classList.remove("is-over");

            const from = this.layers.findIndex(l => l.uid === this.dragUid);
            const to   = this.layers.findIndex(l => l.uid === card.dataset.uid);
            if (from < 0 || to < 0 || from === to) return;

            this.layers.splice(to, 0, this.layers.splice(from, 1)[0]);
            this.renderCards();
            this.applyOrder();
            this.renderLegends();
            this.scheduleSave();
        });
    }

    /** Kartu teratas = pane paling atas. */
    applyOrder() {
        this.layers.forEach((l, i) => l.setZ(Z_TOP - i * Z_GAP));
    }

    renderLegends() {
        this.el.legend.innerHTML = "";

        // Beberapa layer bisa menghasilkan legenda yang isinya identik —
        // dua run TP yang sama-sama pakai skala "rain-line-10", dua radar
        // dengan skala dBZ yang sama, dst. Ditandai lewat isi HTML-nya
        // sendiri (nama + bar + tick), bukan lewat id layer, supaya yang
        // benar-benar sama tampilannya cukup muncul sekali.
        const seen = new Set();

        this.layers.forEach(layer => {
            // Layer statis membawa legend()-nya sendiri; layer NWP
            // menyerahkannya ke renderer.
            const own = layer.kind !== "nwp";
            const make = own
                ? (layer.on && layer.instance ? () => layer.legend() : null)
                : (layer.instance?.legend
                    ? () => layer.instance.legend() : null);
            if (!make) return;

            const box = document.createElement("div");
            box.className = "legend-block";

            if (!own) {
                const name = document.createElement("span");
                name.className   = "legend-name";
                name.textContent = `${layer.title} \u00b7 ${layer.spec.model}`;
                box.appendChild(name);
            }

            box.appendChild(make());

            const sig = box.innerHTML;
            if (seen.has(sig)) return;
            seen.add(sig);

            this.el.legend.appendChild(box);
        });
    }

    /* ---- waktu ---- */

    /**
     * Berapa layer berwaktu yang punya data PERSIS di jam ini.
     * Dipakai menandai jam di mana sebagian layer membeku — layer statis
     * tidak ikut dihitung karena tidak punya dimensi waktu.
     */
    countAt(iso) {
        return this.layers.reduce(
            (n, l) => n + (l.hasTime && l.instance && l.byTime.has(iso) ? 1 : 0), 0);
    }

    /**
     * Timeline = gabungan valid time semua layer. Karena tiap layer bisa
     * memakai run berbeda, rentangnya tidak selalu sama panjang; jam yang
     * tidak dimiliki semua layer ditandai lewat markPartial.
     */
    rebuildTimeline() {
        const keep = this.timebar.times[this.timebar.index] || this.currentTime;

        // Gabungan waktu semua layer berwaktu — NWP maupun tile. Kalau
        // resolusinya berbeda, yang paling halus menentukan timeline dan
        // layer lain membeku di step terakhirnya.
        const set = new Set();
        this.layers.forEach(l => {
            if (l.hasTime) l.byTime.forEach((_, t) => set.add(t));
        });

        if (!set.size) {
            this.timebar.clear();
            this.currentTime = null;
            this.el.valid.textContent = "\u2014";
            this.el.status.textContent = "\u00a0";
            return;
        }

        this.timebar.build([...set].sort(), t => this.countAt(t));
        this.timebar.selectNearest(keep);
    }

    async showTime(iso) {
        this.currentTime = iso;
        this.el.valid.textContent = NWP.time.full(iso);
        this.timebar.setBusy(true);

        const active = this.layers.filter(l => l.hasTime && l.instance);


        const notes = await Promise.all(
            active.map(l => l.show(iso).then(t => t && `${l.title}: ${t}`))
        );

        if (this.currentTime !== iso) return;

        this.el.status.textContent = notes.filter(Boolean).join(" \u00b7 ") || "\u00a0";
        this.timebar.setBusy(false);

        const k    = this.timebar.index;
        const near = [];
        for (let n = 1; n <= APP.prefetch; n++) {
            [k - n, k + n].forEach(kk => {
                if (this.timebar.times[kk]) near.push(this.timebar.times[kk]);
            });
        }
        active.forEach(l => l.prefetch(near));
        this.scheduleSave();
    }
}

