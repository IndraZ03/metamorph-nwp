/* =====================================================================
 * app.js — shell aplikasi
 *
 * Tidak tahu cara menggambar apa pun. Tugasnya: peta, panel layer,
 * popup pemilih data, timeline + play, cache fetch, legenda.
 * Rendering diserahkan ke file di script/layers/ lewat NWP.registerRenderer.
 *
 * Alur data
 *   CATALOG.json  -> model / parameter / level / init apa saja yang ada
 *   INDEX         -> daftar run satu produk + url manifest tiap run
 *   manifest      -> daftar step + url file data
 *   file data     -> grid untuk satu valid time
 *
 * Panel layer mulai KOSONG. Tiap layer dibuat saat pengguna menekan Add,
 * membawa init time-nya sendiri — jadi dua kartu bisa menampilkan run
 * berbeda dari produk yang sama untuk perbandingan.
 *
 * meta/parameters.json hanya berisi gaya per parameter, bukan daftar layer.
 * ===================================================================== */

const CONFIG_URL = "meta/parameters.json";

const DEFAULTS = {
    center   : { latlng: [-2.6, 115.6], zoom: 7 },
    prefetch : 2,
    cacheBust: true,
    styles   : {},
};

// Pane z-index diturunkan dari urutan kartu, bukan dari config: kartu
// teratas = layer paling atas.
const Z_TOP = 500;
const Z_GAP = 10;

let APP = DEFAULTS;
let uidSeq = 0;

async function loadConfig() {
    let r;
    try {
        r = await fetch(CONFIG_URL, { cache: "no-store" });
    } catch (e) {
        throw new Error(`${CONFIG_URL} tidak bisa diambil (${e.message})`);
    }
    if (!r.ok) throw new Error(`${CONFIG_URL} — HTTP ${r.status}`);

    let cfg;
    try {
        cfg = await r.json();
    } catch (e) {
        throw new Error(`${CONFIG_URL} bukan JSON yang valid (${e.message})`);
    }
    if (!cfg.catalog) throw new Error(`${CONFIG_URL} tidak punya "catalog"`);
    cfg.staticCatalog = cfg.staticCatalog || "meta/static.json";
    cfg.tileCatalog   = cfg.tileCatalog   || "meta/satellite.json";
    cfg.radarCatalog  = cfg.radarCatalog  || "meta/radar.json";
    cfg.ef5Catalog    = cfg.ef5Catalog    || "meta/ef5.json";
    cfg.colorbars     = cfg.colorbars     || "meta/colorbars.json";

    return { ...DEFAULTS, ...cfg };
}

/** CATALOG dan INDEX berubah tiap run tapi URL-nya tetap. */
function bust(url) {
    if (!APP.cacheBust) return url;
    return url + (url.includes("?") ? "&" : "?") + "t=" + Date.now();
}

/**
 * Gaya untuk satu produk. Dicari makin umum: PARAMETER.LEVEL, lalu
 * PARAMETER, lalu bawaan berdasarkan `type` di katalog — sehingga
 * parameter baru tetap tampil meski belum punya entri gaya.
 */
function styleFor(spec) {
    const s = APP.styles;
    const hit = s[`${spec.parameter}.${spec.level}`] || s[spec.parameter];
    if (hit) return hit;
    return { renderer: NWP.rendererForType(spec.type), options: {} };
}

/* ------------------------------------------------------------------ */
/* Time bar                                                            */
/* ------------------------------------------------------------------ */

class TimeBar {

    constructor(stripEl, onSelect) {
        this.strip    = stripEl;
        this.onSelect = onSelect;
        this.times    = [];
        this.buttons  = [];
        this.index    = -1;

        this.prevBtn  = document.getElementById("btn-prev");
        this.nextBtn  = document.getElementById("btn-next");
        this.playBtn  = document.getElementById("btn-play");
        this.speedSel = document.getElementById("speed");

        this.prevBtn.addEventListener("click", () => { this.stop(); this.step(-1); });
        this.nextBtn.addEventListener("click", () => { this.stop(); this.step(+1); });
        this.playBtn.addEventListener("click", () => this.togglePlay());
        this.speedSel.addEventListener("change", () => {
            if (this.timer) { this.stop(); this.play(); }
        });

        document.addEventListener("keydown", e => {
            const t = e.target.tagName;
            if (t === "INPUT" || t === "SELECT" || t === "TEXTAREA") return;
            if (e.key === "ArrowLeft")  { this.stop(); this.step(-1); e.preventDefault(); }
            if (e.key === "ArrowRight") { this.stop(); this.step(+1); e.preventDefault(); }
            if (e.key === " ")          { this.togglePlay(); e.preventDefault(); }
        });

        this.setEnabled(false);
    }

    setEnabled(on) {
        this.playBtn.disabled = !on;
        if (!on) {
            this.prevBtn.disabled = true;
            this.nextBtn.disabled = true;
        }
    }

    clear() {
        this.stop();
        this.times   = [];
        this.buttons = [];
        this.index   = -1;
        this.strip.innerHTML =
            '<p class="tb-empty">Tambahkan data untuk menampilkan rentang waktu.</p>';
        this.setEnabled(false);
    }

    /**
     * @param times   daftar valid_time (ISO) terurut
     * @param countAt iso -> berapa layer aktif yang punya step itu
     */
    build(times, countAt) {
        if (!times.length) return this.clear();

        this.times   = times;
        this.buttons = [];
        this.index   = -1;
        this.strip.innerHTML = "";
        this.setEnabled(true);

        let group = null, lastDay = null, firstOfDay = 0;

        times.forEach((iso, k) => {
            const d  = NWP.time.parse(iso);
            const dk = NWP.time.dayKey(d);

            if (dk !== lastDay) {
                firstOfDay = k;
                group = document.createElement("div");
                group.className = "tb-day";

                const label = document.createElement("button");
                label.type        = "button";
                label.className   = "tb-day-label";
                label.textContent = NWP.time.dayLabel(d);
                label.title       = "Lompat ke awal hari ini";
                const jumpTo = firstOfDay;
                label.addEventListener("click", () => {
                    this.stop();
                    this.select(jumpTo);
                });

                const hours = document.createElement("div");
                hours.className = "tb-hours";

                group.append(label, hours);
                this.strip.appendChild(group);
                group._hours = hours;
                lastDay = dk;
            }

            const b = document.createElement("button");
            b.type        = "button";
            b.className   = "tb-hour";
            b.textContent = NWP.time.hhmm(d);
            b.title       = NWP.time.full(iso);
            b.addEventListener("click", () => { this.stop(); this.select(k); });

            group._hours.appendChild(b);
            this.buttons.push(b);
        });

        if (countAt) this.markPartial(countAt);
    }

    /** Tandai jam yang tidak semua layer aktifnya punya data. */
    markPartial(countAt) {
        if (!this.times.length) return;
        const max = Math.max(0, ...this.times.map(countAt));
        this.times.forEach((iso, k) => {
            this.buttons[k].classList.toggle("is-partial", countAt(iso) < max);
        });
    }

    step(d) { this.select(this.index + d); }

    select(k, force = false) {
        if (!this.times.length) return;
        if (k < 0 || k >= this.times.length) return;
        if (k === this.index && !force) return;

        this.buttons[this.index]?.classList.remove("is-active");
        this.index = k;

        const b = this.buttons[k];
        b.classList.add("is-active");
        b.scrollIntoView({ block: "nearest", inline: "center", behavior: "smooth" });

        this.prevBtn.disabled = (k === 0);
        this.nextBtn.disabled = (k === this.times.length - 1);

        this.onSelect(this.times[k], k);
    }

    selectNearest(targetIso) {
        if (!this.times.length) return;
        if (!targetIso) return this.select(this.defaultIndex(), true);

        const t = Date.parse(targetIso);
        let best = 0, bestD = Infinity;
        this.times.forEach((iso, k) => {
            const d = Math.abs(Date.parse(iso) - t);
            if (d < bestD) { bestD = d; best = k; }
        });
        this.select(best, true);
    }

    /** Step pertama yang >= jam berikutnya dari sekarang (UTC). */
    defaultIndex() {
        const t = new Date();
        t.setUTCMinutes(0, 0, 0);
        t.setUTCHours(t.getUTCHours() + 1);
        const idx = this.times.findIndex(iso => Date.parse(iso) >= t.getTime());
        return idx < 0 ? this.times.length - 1 : idx;
    }

    togglePlay() { this.timer ? this.stop() : this.play(); }

    play() {
        if (this.times.length < 2) return;

        this.playBtn.textContent = "\u275a\u275a";
        this.playBtn.setAttribute("aria-label", "Jeda");

        this.timer = setInterval(() => {
            // Lewati tick kalau frame sebelumnya masih dimuat, supaya
            // animasi tidak menumpuk permintaan saat jaringan lambat.
            if (this.busy) return;
            const next = this.index + 1;
            this.select(next >= this.times.length ? 0 : next);
        }, Number(this.speedSel.value));
    }

    stop() {
        if (!this.timer) return;
        clearInterval(this.timer);
        this.timer = null;
        this.playBtn.textContent = "\u25b6";
        this.playBtn.setAttribute("aria-label", "Putar");
    }

    setBusy(on) {
        this.busy = !!on;
        this.strip.classList.toggle("is-busy", !!on);
    }
}

/* ------------------------------------------------------------------ */
/* Satu layer                                                          */
/* ------------------------------------------------------------------ */

class Layer {

    /**
     * @param spec {model, domain, parameter, level, long_name, unit, type,
     *              indexUrl, init}
     */
    constructor(spec, map) {
        this.uid  = `L${++uidSeq}`;
        this.spec = spec;
        this.map  = map;

        const style   = styleFor(spec);
        this.renderer = style.renderer;

        const opt = { ...(style.options || {}) };

        // Skala warna dirujuk lewat nama; daftar pilihannya disimpan di
        // layer supaya kartu bisa menawarkan penggantian setelah tampil.
        this.colorbars = NWP.colorbars.available(opt.colorbar);
        this.colorbar  = this.colorbars.includes(opt.colorbar_default)
            ? opt.colorbar_default
            : (this.colorbars[0] || null);

        delete opt.colorbar;
        delete opt.colorbar_default;

        // levels/colors yang ditulis langsung di parameters.json menang
        // atas colorbar_default — jalan keluar untuk gaya sekali pakai.
        const fromBar = this.colorbar ? NWP.colorbars.resolve(this.colorbar) : {};
        this.options = {
            ...fromBar,
            ...opt,
            unit: spec.unit,
        };

        this.manifest = null;
        this.byTime   = new Map();
        this.cache    = new Map();
        this.instance = null;
        this.token    = 0;
        this.kind      = "nwp";
        this.hasTime   = true;
        this.on        = true;   // layer baru selalu aktif
        this.opacity   = 1;      // dan opasitas penuh
        this.threshold = null;   // {mode:'gt'|'lt'|'range', min, max}

        this.paneName = `nwp-${this.uid}`;
        this.pane = map.createPane(this.paneName);
        this.pane.style.pointerEvents = "none";
        this.pane.style.opacity = "1";
    }

    /** "RH 700" / "TP" — nama pendek untuk judul kartu. */
    get title() {
        const lv = this.spec.level;
        return lv && lv !== "SFC"
            ? `${this.spec.parameter} ${lv}`
            : this.spec.parameter;
    }

    /** "WRF KALIMANTAN · 04/09 12:00Z" — asal-usul, agar dua kartu
     *  dari produk sama tapi run berbeda tidak tertukar. */
    get origin() {
        const d = NWP.time.parse(this.spec.init);
        const p = n => String(n).padStart(2, "0");
        return `${this.spec.model} ${this.spec.domain} \u00b7 `
             + `${p(d.getUTCDate())}/${p(d.getUTCMonth() + 1)} `
             + `${NWP.time.hhmm(d)}Z`;
    }

    get def() { return NWP.getRenderer(this.renderer); }

    url(u) { return NWP.resolveUrl(u, this.spec.indexUrl); }

    setOpacity(v) {
        this.opacity = v;
        this.pane.style.opacity = String(v);
    }

    setZ(z) { this.pane.style.zIndex = String(z); }

    async loadRun(manifestUrl) {
        const r = await fetch(this.url(manifestUrl));
        if (!r.ok) throw new Error(`${r.status} manifest`);

        this.manifest = await r.json();
        this.byTime   = new Map(this.manifest.steps.map(s => [s.valid_time, s]));
        return this.manifest;
    }

    fetchStep(s) {
        const url = this.url(s.url);
        if (this.cache.has(url)) return this.cache.get(url);

        const def = this.def;
        const p = fetch(url)
            .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
            .then(json => def.parse(json, this.manifest));

        this.cache.set(url, p);
        return p;
    }

    /** Renderer yang menandai dirinya colorable dapat pemilih warna di kartu. */
    get colorable() { return !!this.def.colorable; }

    setColorbar(name) {
        const bar = NWP.colorbars.resolve(name);
        if (!bar.levels) return;

        this.colorbar = name;
        Object.assign(this.options, bar);
        // Warna tunggal dari pemilih warna tidak lagi berlaku.
        delete this.options.color;

        this.instance?.setColorbar?.(bar);
    }

    setColor(c) {
        this.options.color = c;
        this.instance?.setColor?.(c);
    }

    setThreshold(t) {
        this.threshold = t;
        this.instance?.setThreshold?.(t);
    }

    /**
     * Ganti antara kontur terisi dan garis TANPA membuat ulang layer.
     * Nama renderer diperbarui juga, karena `colorable` (dipakai
     * SettingsPicker.renderLineColor() untuk menentukan apakah bagian
     * Warna ditampilkan) dibaca dari situ lewat NWP.getRenderer(this.renderer)
     * — mode garis colorable, mode terisi tidak.
     */
    setDisplayMode(mode) {
        if (mode !== "fill" && mode !== "line") return;
        this.renderer = mode === "line" ? "line" : "contour";
        this.instance?.setMode?.(mode);
    }

    get displayMode() {
        return this.instance?.mode || (this.renderer === "line" ? "line" : "fill");
    }

    setSmooth(v) {
        this.options.smooth = !!v;
        this.instance?.setSmooth?.(!!v);
    }

    /** Kontur dan garis berasal dari kelas yang sama, jadi bisa saling
     *  bertukar mode; layer lain (barb, tile, statis) tidak. */
    get canSwitchDisplay() {
        return this.renderer === "contour" || this.renderer === "line";
    }

    mount() {
        if (this.instance) return;
        this.instance = this.def.create(this.map, {
            ...this.options,
            pane: this.paneName,
        });
    }

    unmount() {
        this.token++;
        this.instance?.remove();
        this.instance = null;
    }

    destroy() {
        this.unmount();
        this.pane.remove();
    }

    /**
     * Step terakhir yang valid_time-nya <= iso.
     *
     * Timeline bisa lebih halus dari langkah layer ini — misalnya saat
     * satelit 10 menitan ikut ditambahkan. Aturannya: tampilkan data
     * terakhir yang sudah berlaku, jangan data masa depan. Jadi di jam
     * 00:30 layer NWP per jam tetap menampilkan 00:00.
     */
    resolve(iso) {
        if (this.byTime.has(iso)) return this.byTime.get(iso);

        const t = Date.parse(iso);
        let hit = null;
        for (const s of this.manifest?.steps || []) {
            if (Date.parse(s.valid_time) <= t) hit = s; else break;
        }
        return hit;
    }

    async show(iso) {
        const s = this.resolve(iso);
        if (!s || !this.instance) return null;

        const my = ++this.token;
        try {
            const field = await this.fetchStep(s);
            if (my !== this.token || !this.instance) return null;
            this.instance.setField(field);

            const note = this.instance.describe?.() || "";
            if (s.valid_time === iso) return note;

            // Beri tahu kalau yang tampil bukan jam yang diminta.
            const froze = NWP.time.hhmm(NWP.time.parse(s.valid_time));
            return note ? `${note} (${froze})` : `${froze}`;
        } catch (e) {
            if (my !== this.token) return null;
            return `gagal (${e.message})`;
        }
    }

    prefetch(times) {
        // Ambil step unik yang akan dipakai oleh waktu-waktu tetangga.
        // Pakai resolve(), bukan cocok persis: di timeline 10 menitan,
        // tetangga terdekat sering memakai step yang sama.
        const seen = new Set();
        times.forEach(iso => {
            const s = this.resolve(iso);
            if (s && !seen.has(s.url)) {
                seen.add(s.url);
                this.fetchStep(s).catch(() => {});
            }
        });
    }
}

/* ------------------------------------------------------------------ */
/* Popup pemilih data                                                  */
/* ------------------------------------------------------------------ */

/**
 * Kabel standar untuk semua popup: klik elemen [data-close] atau tombol
 * Escape menutupnya. Diekstrak karena pola ini terulang di tujuh kelas
 * popup — dan pengulangan itu pernah membuat satu popup (GPX) lupa
 * dikasih penutup lewat Escape, gejala umum saat boilerplate disalin
 * tangan alih-alih dibagi dari satu tempat.
 */
function bindModalClose(root, onClose) {
    root.querySelectorAll("[data-close]")
        .forEach(n => n.addEventListener("click", onClose));

    document.addEventListener("keydown", e => {
        if (e.key === "Escape" && !root.hidden) onClose();
    });
}

const STORAGE_KEY     = "nwpViewer.state.v1";
const STORAGE_VERSION = 1;

/**
 * Simpan/pulihkan susunan layer supaya refresh halaman tidak membuang
 * kerja pengguna. Yang DIPULIHKAN hanya layer yang bisa dibangun ulang
 * dari sumber yang stabil:
 *
 *   nwp    : model/parameter/level/init — dibangun ulang lewat INDEX
 *            dan manifest yang sama seperti saat pertama ditambahkan.
 *   static : HANYA yang berasal dari katalog (punya id). Upload manual
 *            (spec.geo / spec.gpx) sengaja TIDAK disimpan — isinya bisa
 *            besar dan sudah tidak ada begitu tab ditutup, jadi mencoba
 *            memulihkannya cuma akan gagal diam-diam.
 *   tile   : dicocokkan ulang lewat id di meta/satellite.json.
 *   radar  : dicocokkan ulang lewat kode situs di meta/radar.json.
 *   draw   : bentuk yang sudah digambar, lewat GeoJSON (kecil, aman
 *            disimpan apa adanya).
 *   gpx    : TIDAK disimpan, alasan sama dengan upload statis — trek
 *            GPX bisa berukuran besar dan cuma ada di memori tab ini.
 */
function loadPersisted() {
    let raw;
    try {
        raw = localStorage.getItem(STORAGE_KEY);
    } catch (e) {
        console.warn("localStorage tidak bisa diakses:", e);
        return null;
    }
    if (!raw) return null;

    try {
        const state = JSON.parse(raw);
        if (state?.version !== STORAGE_VERSION) return null;
        return state;
    } catch (e) {
        console.warn("State tersimpan rusak, diabaikan:", e);
        return null;
    }
}

function writePersisted(state) {
    try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch (e) {
        // Kuota penuh atau mode privat — jangan sampai ini menghentikan
        // aplikasi, cukup diam-diam gagal.
        console.warn("Gagal menyimpan state:", e);
    }
}

class Picker {

    constructor(catalogUrl, onAdd) {
        this.catalogUrl = catalogUrl;
        this.onAdd      = onAdd;
        this.catalog    = null;

        this.el = {
            root  : document.getElementById("picker"),
            models: document.getElementById("pick-models"),
            params: document.getElementById("pick-params"),
            levels: document.getElementById("pick-levels"),
            init  : document.getElementById("pick-init"),
            hint  : document.getElementById("pick-hint"),
            add   : document.getElementById("btn-do-add"),
            refresh: document.getElementById("pick-refresh"),
            updated: document.getElementById("pick-updated"),
        };

        bindModalClose(this.el.root, () => this.close());

        this.el.add.addEventListener("click", () => this.add());
        this.el.refresh.addEventListener("click", () => this.refresh());

        // Listener baru: Saat initial time diganti, render ulang param dan level
        this.el.init.addEventListener("change", () => {
            this.initTime = this.el.init.value;
            this.renderParams();
        });
    }

    async load() {
        const r = await fetch(bust(this.catalogUrl), { cache: "no-store" });
        if (!r.ok) throw new Error(`${r.status} ${this.catalogUrl}`);
        this.catalog = await r.json();
        this.fetchedAt = new Date();
        return this.catalog;
    }

    /** Semua init time yang ada di katalog, terbaru dulu. */
    allRuns(catalog = this.catalog) {
        const set = new Set();
        (catalog?.models || []).forEach(mo =>
            mo.parameters.forEach(par =>
                par.levels.forEach(lv => (lv.runs || []).forEach(r => set.add(r)))));
        return [...set].sort((a, b) => b.localeCompare(a));
    }

    /** Ringkas pilihan yang sedang aktif sebagai nilai, bukan objek:
     *  setelah katalog dimuat ulang, objeknya sudah diganti yang baru. */
    snapshot() {
        return {
            model    : this.model?.model,
            domain   : this.model?.domain,
            parameter: this.param?.parameter,
            level    : this.level?.level,
            init     : this.initTime,
            runs     : this.allRuns(),
        };
    }

    /**
     * Ambil ulang katalog tanpa menutup popup dan tanpa menghilangkan
     * pilihan yang sedang dibuat. Layer yang sudah ada di peta TIDAK
     * disentuh — katalog hanya menentukan apa yang ditawarkan popup.
     */
    async refresh() {
        const before = this.snapshot();

        this.el.refresh.disabled = true;
        this.el.refresh.classList.add("is-busy");

        try {
            await this.load();
            this.buildModels();
            this.restore(before);

            const after = this.allRuns();
            const fresh = after.filter(r => !before.runs.includes(r));
            const gone  = before.runs.filter(r => !after.includes(r));

            const bits = [];
            if (fresh.length) {
                bits.push(`${fresh.length} run baru \u2014 terbaru `
                        + NWP.time.full(fresh[0]));
            }
            // Run yang hilang biasanya karena keep_runs di pipeline; layer
            // yang masih menunjuk ke sana akan berhenti bisa memuat step.
            if (gone.length) bits.push(`${gone.length} run lama dihapus`);
            if (!bits.length) bits.push("Katalog sudah yang terbaru");

            this.el.hint.textContent = bits.join(" \u00b7 ");
            this.stamp();

        } catch (e) {
            this.el.hint.textContent = `Katalog gagal disegarkan: ${e.message}`;
        } finally {
            this.el.refresh.disabled = false;
            this.el.refresh.classList.remove("is-busy");
        }
    }

    /** Pulihkan pilihan berdasarkan nama, sejauh masih ada di katalog baru. */
    restore(sel) {
        const models = this.catalog.models || [];
        if (!models.length) return;

        const mo = models.find(m => m.model === sel.model
                                 && m.domain === sel.domain) || models[0];

        this.model = mo;
        [...this.el.models.children].forEach(b =>
            b.classList.toggle("is-active", b._model === mo));

        const runs = this.buildRuns(mo);
        this.initTime = runs.includes(sel.init) ? sel.init : (runs[0] || null);
        if (this.initTime) this.el.init.value = this.initTime;

        this.param = mo.parameters.find(p => p.parameter === sel.parameter) || null;
        this.level = this.param
            ? (this.param.levels.find(l => l.level === sel.level) || null)
            : null;

        this.renderParams();
    }

    stamp() {
        if (!this.el.updated) return;
        const t = this.fetchedAt;
        if (!t) { this.el.updated.textContent = ""; return; }
        const p = n => String(n).padStart(2, "0");
        this.el.updated.textContent =
            `diambil ${p(t.getUTCHours())}:${p(t.getUTCMinutes())} UTC`;
    }

    open() {
        this.el.root.hidden = false;
        if (!this.model) this.pickModel(this.catalog.models[0]);
        this.stamp();
    }

    close() { this.el.root.hidden = true; }

    /* ---- model ---- */

    buildModels() {
        this.el.models.innerHTML = "";

        this.catalog.models.forEach(mo => {
            const b = document.createElement("button");
            b.type        = "button";
            b.className   = "tab";
            b.role        = "tab";
            b.textContent = mo.label || `${mo.model} ${mo.domain}`;
            b.addEventListener("click", () => this.pickModel(mo));
            b._model = mo;
            this.el.models.appendChild(b);
        });
    }

    pickModel(mo) {
        this.model = mo;
        this.param = null;
        this.level = null;

        [...this.el.models.children].forEach(b =>
            b.classList.toggle("is-active", b._model === mo));

        const runs = this.buildRuns(mo);
        this.initTime = runs.length ? runs[0] : null;

        this.renderParams();
    }

    /**
     * Isi dropdown Initial Time dari seluruh param dan level milik model
     * ini. Dipisah dari pickModel supaya refresh bisa memakainya ulang
     * tanpa ikut mereset parameter dan level yang sedang dipilih.
     * @returns daftar init time, terbaru dulu
     */
    buildRuns(mo) {
        const set = new Set();
        mo.parameters.forEach(par =>
            par.levels.forEach(lv => (lv.runs || []).forEach(r => set.add(r))));

        const runs = [...set].sort((a, b) => b.localeCompare(a));

        this.el.init.innerHTML = "";
        runs.forEach(iso => {
            const o = document.createElement("option");
            o.value = iso;
            o.textContent = NWP.time.full(iso);
            this.el.init.appendChild(o);
        });

        this.el.init.disabled = runs.length === 0;
        return runs;
    }

    /* ---- parameter & level ---- */

    renderParams() {
        if (!this.model || !this.initTime) {
            this.el.params.innerHTML = "";
            this.el.levels.innerHTML = "";
            this.refreshAdd();
            return;
        }

        // Saring parameter yang TERSEDIA pada initial time yang sedang terpilih
        const availableParams = this.model.parameters.filter(p => 
            p.levels.some(l => (l.runs || []).includes(this.initTime))
        );

        // Jika param yang sebelumnya dipilih TIDAK ADA di waktu ini, reset
        if (this.param && !availableParams.includes(this.param)) {
            this.param = null;
        }

        this.el.params.innerHTML = "";
        availableParams.forEach(par => {
            const b = document.createElement("button");
            b.type        = "button";
            b.className   = "chip";
            b.textContent = par.parameter;
            b.title       = par.levels.map(l => l.long_name).join(" / ");
            b.addEventListener("click", () => this.pickParam(par));
            b._par = par;
            
            if (this.param === par) b.classList.add("is-active");
            this.el.params.appendChild(b);
        });

        this.renderLevels();
    }

    pickParam(par) {
        this.param = par;
        [...this.el.params.children].forEach(b =>
            b.classList.toggle("is-active", b._par === par));
        this.renderLevels();
    }

    renderLevels() {
        this.el.levels.innerHTML = "";

        if (!this.param) {
            this.el.hint.textContent = "Pilih parameter.";
            this.refreshAdd();
            return;
        }

        // Saring level yang TERSEDIA pada initial time yang sedang terpilih
        const availableLevels = this.param.levels.filter(l => 
            (l.runs || []).includes(this.initTime)
        );

        // Jika level yang sebelumnya dipilih TIDAK ADA di waktu/param ini, reset
        if (this.level && !availableLevels.includes(this.level)) {
            this.level = null;
        }

        availableLevels.forEach(lv => {
            const b = document.createElement("button");
            b.type        = "button";
            b.className   = "chip";
            b.textContent = lv.level;
            b.title       = lv.long_name;
            b.addEventListener("click", () => this.pickLevel(lv));
            b._lv = lv;
            
            if (this.level === lv) b.classList.add("is-active");
            this.el.levels.appendChild(b);
        });

        // Auto-select jika level menjadi null TAPI hanya ada 1 level yang tersedia
        if (!this.level && availableLevels.length === 1) {
            this.level = availableLevels[0];
            this.el.levels.children[0].classList.add("is-active");
        }

        this.el.hint.textContent = this.level ? this.level.long_name : "Pilih level.";
        this.refreshAdd();
    }

    pickLevel(lv) {
        this.level = lv;
        [...this.el.levels.children].forEach(b =>
            b.classList.toggle("is-active", b._lv === lv));
        this.el.hint.textContent = lv.long_name;
        this.refreshAdd();
    }

    refreshAdd() {
        this.el.add.disabled = !(this.model && this.param && this.level && this.initTime);
    }

    add() {
        if (this.el.add.disabled) return;

        this.onAdd({
            model    : this.model.model,
            domain   : this.model.domain,
            parameter: this.param.parameter,
            level    : this.level.level,
            long_name: this.level.long_name,
            unit     : this.param.unit,
            type     : this.param.type,
            indexUrl : NWP.resolveUrl(this.level.index, this.catalogUrl),
            init     : this.initTime, // Mengambil dari state, bukan DOM
            manifest : null,   
        });
    }
}

