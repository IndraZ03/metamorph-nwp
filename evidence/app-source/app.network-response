const SWATCHES = ["#ed3036", "#c24d00", "#8a5a00", "#1f8a1f",
                  "#1f6fb2", "#5b3fa8", "#3b3b3b"];

// Untuk barb yang penting kontras terhadap field di bawahnya, bukan
// kekayaan warna: hitam, putih, dan tiga warna jenuh.
const BARB_SWATCHES = ["#1a1a1a", "#ffffff", "#d81f12", "#193361", "#f7de00"];

class StaticPicker {

    constructor(url, onAdd) {
        this.url     = url;
        this.onAdd   = onAdd;
        this.catalog = null;
        this.pick    = null;

        // Popup hanya memilih DATA. Warna dan gaya garis diatur di kartu
        // layer, karena pilihan yang tepat baru kelihatan setelah layer
        // bertumpuk di peta — dan di sana bisa diubah tanpa menambah ulang.
        this.el = {
            root     : document.getElementById("picker-static"),
            list     : document.getElementById("static-list"),
            hint     : document.getElementById("static-hint"),
            file     : document.getElementById("static-file"),
            add      : document.getElementById("btn-do-add-static"),
            fieldRow : document.getElementById("static-label-field-row"),
            field    : document.getElementById("static-label-field"),
        };

        // Isi data yang sedang dipilih (geo sudah di-parse, bukan cuma
        // rujukan file) — disimpan supaya add() tahu properti apa saja
        // yang ada tanpa perlu fetch ulang.
        this._pickedGeo = null;

        this.el.file.addEventListener("change", () => this.upload());

        bindModalClose(this.el.root, () => this.close());

        this.el.add.addEventListener("click", () => this.add());
    }

    async load() {
        const r = await fetch(this.url, { cache: "no-store" });
        if (!r.ok) throw new Error(`${r.status} ${this.url}`);
        this.catalog = await r.json();

        this.el.list.innerHTML = "";
        (this.catalog.data || []).forEach(d => {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "chip";
            b.textContent = d.label;
            b.title = d.file;
            b.addEventListener("click", () => this.select(d));
            b._d = d;
            this.el.list.appendChild(b);
        });

        return this.catalog;
    }

    open()  {
        this.el.root.hidden = false;
        // Bersihkan sisa pilihan sebelumnya — tanpa ini dropdown field
        // bisa menampilkan properti dari data yang berbeda kalau popup
        // dibuka lagi setelah sebelumnya sempat pilih data lain.
        this.pick = null;
        this._pickedGeo = null;
        this.populateLabelFields([]);
        this.el.add.disabled = true;
        this.el.hint.textContent = "Pilih data atau unggah file.";
        [...this.el.list.children].forEach(b => b.classList.remove("is-active"));
    }
    close() { this.el.root.hidden = true; }

    /**
     * Baca GeoJSON dari disk pengguna. Isinya dibawa langsung ke layer
     * lewat spec.geo — tidak diunggah ke server dan tidak disimpan, jadi
     * hilang saat tab ditutup.
     */
    upload() {
        const f = this.el.file.files?.[0];
        if (!f) return;

        const reader = new FileReader();
        const ext = f.name.split('.').pop().toLowerCase();

        reader.onload = () => {
            const specTemplate = {
                id   : `upload-${Date.now()}`,
                label: f.name.replace(/\.(geo)?json$|\.gpx$/i, ""),
                file : `(unggahan) ${f.name}`,
                style: { color: "#5b3fa8", weight: 1.5, dash: "solid", fill: false },
            };

            if (ext === 'gpx') {
                // Lewatkan raw text XML untuk leaflet-gpx
                this.onAdd({ ...specTemplate, gpx: reader.result });
            } else {
                // Penanganan GeoJSON eksisting
                let geo;
                try {
                    geo = JSON.parse(reader.result);
                } catch (err) {
                    this.el.hint.textContent = `${f.name}: bukan JSON yang valid`;
                    return;
                }

                if (!geo.type || !/Feature|Geometry|Collection/.test(geo.type)) {
                    this.el.hint.textContent = `${f.name}: bukan GeoJSON`;
                    return;
                }
                this.onAdd({ ...specTemplate, geo });
            }
        };

        reader.onerror = () => {
            this.el.hint.textContent = `${f.name} gagal dibaca`;
        };

        reader.readAsText(f);
        this.el.file.value = "";
    }

    /** Nama properti unik dari seluruh feature — dipakai isi dropdown
     *  label, di sini dan (dengan logika yang sama) di StaticLayer
     *  sendiri untuk popup Gaya sesudah layer ditambahkan. */
    static fieldsOf(geo) {
        if (!geo) return [];
        const features = geo.type === "FeatureCollection" ? geo.features
                        : geo.type === "Feature" ? [geo]
                        : [];
        const keys = new Set();
        features.forEach(f => Object.keys(f.properties || {}).forEach(k => keys.add(k)));
        return [...keys].sort();
    }

    populateLabelFields(fields) {
        this.el.field.innerHTML = '<option value="">Tidak ada</option>';
        fields.forEach(k => {
            const o = document.createElement("option");
            o.value = k;
            o.textContent = k;
            this.el.field.appendChild(o);
        });
        this.el.fieldRow.hidden = fields.length === 0;
    }

    async select(d) {
        this.pick = d;
        [...this.el.list.children].forEach(b =>
            b.classList.toggle("is-active", b._d === d));

        this.el.hint.textContent = d.file;
        this.el.add.disabled = false;

        // Ambil isinya sekarang (bukan menunggu StaticLayer.load() nanti)
        // semata supaya dropdown field label bisa diisi SEBELUM layer
        // ditambahkan — pengguna memilih field sambil melihat pilihannya,
        // bukan menebak nama properti lalu mengeceknya belakangan.
        this._pickedGeo = null;
        this.populateLabelFields([]);
        try {
            const r = await fetch(d.file);
            if (r.ok) {
                this._pickedGeo = await r.json();
                this.populateLabelFields(StaticPicker.fieldsOf(this._pickedGeo));
            }
        } catch {
            // Field label murni kenyamanan tambahan — kalau fetch di sini
            // gagal, biarkan saja; StaticLayer akan fetch ulang saat
            // mount() dan errornya (kalau memang berkasnya bermasalah)
            // akan muncul jelas di situ, bukan didobelkan di sini.
        }
    }

    add() {
        if (!this.pick) return;
        // Gaya bawaan dari katalog dipakai apa adanya; penyesuaiannya
        // dilakukan di kartu setelah layer muncul di peta. label_field
        // dari dropdown ini beda — itu cuma bisa dipilih SEKARANG,
        // sebelum layer ada (sesudahnya juga bisa diubah lewat popup
        // Gaya, tapi memilih di awal saat baru melihat datanya lebih
        // wajar daripada menebak nama field belakangan).
        const field = this.el.field.value || null;
        this.onAdd({ ...this.pick, label_field: field, showLabel: !!field });
    }
}

