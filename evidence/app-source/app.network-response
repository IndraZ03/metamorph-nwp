class RadarPicker {

    constructor(url, onAdd) {
        this.url     = url;
        this.onAdd   = onAdd;
        this.catalog = null;
        this.pick    = null;

        this.el = {
            root   : document.getElementById("picker-radar"),
            list   : document.getElementById("radar-list"),
            hint   : document.getElementById("radar-hint"),
            opacity: document.getElementById("radar-opacity"),
            note   : document.getElementById("radar-note"),
            add    : document.getElementById("btn-do-add-radar"),
        };

        bindModalClose(this.el.root, () => this.close());

        this.el.add.addEventListener("click", () => this.add());
    }

    async load() {
        const r = await fetch(this.url, { cache: "no-store" });
        if (!r.ok) throw new Error(`${r.status} ${this.url}`);
        this.catalog = await r.json();

        const base    = (this.catalog.base || "data/wxr").replace(/\/+$/, "");
        const product = this.catalog.product || "CMAX";
        // legends nyaris selalu sama untuk semua situs CMAX — dipakai
        // bersama dari level produk kecuali situs punya legends sendiri.
        const sharedLegends = this.catalog.legends || null;

        this.el.list.innerHTML = "";
        (this.catalog.sites || []).forEach(site => {
            // Lokasi manifest diturunkan dari kode situs, jadi menambah
            // radar baru cukup satu baris di katalog.
            const prod = site.product || product;
            const dir  = site.dir || `${base}/${site.code}/${prod}`;

            const spec = {
                code    : site.code,
                label   : site.label || site.code,
                product : prod,
                dir,
                manifest: site.manifest || `${dir}/${site.code}_${prod}_latest.json`,
                // Statis dari katalog — tidak lagi dibaca dari manifest.
                bounds  : site.bounds || null,
                legends : site.legends || sharedLegends,
                Stasiun : site.Stasiun || null,
                lat     : site.lat ?? null,
                lon     : site.lon ?? null,
            };

            const b = document.createElement("button");
            b.type = "button";
            b.className = "chip";
            b.textContent = spec.label;
            b.title = spec.manifest;
            if (!spec.bounds) {
                // Situs belum lengkap di katalog (mis. PKY) — jangan
                // biarkan dipilih sampai bounds-nya diisi.
                b.disabled = true;
                b.title = `${spec.manifest} — bounds belum ada di katalog`;
            }
            b.addEventListener("click", () => this.select(spec));
            b._spec = spec;
            this.el.list.appendChild(b);
        });

        return this.catalog;
    }

    select(spec) {
        this.pick = spec;
        [...this.el.list.children].forEach(b =>
            b.classList.toggle("is-active", b._spec === spec));

        this.el.hint.textContent = `${spec.code} \u00b7 ${spec.product}`;
        this.el.note.textContent =
            "Citra tiap 10 menit dari history di manifest. Menambahkan ini "
          + "membuat timeline turun ke resolusi 10 menit; layer NWP akan "
          + "membeku di jam bulat.";
        this.el.add.disabled = false;
    }

    /** Cari kembali spec yang sama seperti yang dibangun load() untuk
     *  kode situs tertentu — dipakai memulihkan layer radar tersimpan
     *  tanpa menduplikasi rumus dir/manifest di tempat lain. */
    findSpec(code) {
        const btn = [...this.el.list.children].find(b => b._spec.code === code);
        return btn?._spec ?? null;
    }

    open()  { this.el.root.hidden = false; }
    close() { this.el.root.hidden = true; }

    add() {
        if (!this.pick) return;
        this.onAdd({ ...this.pick, opacity: Number(this.el.opacity.value) });
    }
}

